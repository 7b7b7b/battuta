<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="Battuta.FontFamily">Segoe UI Variable, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Battuta.SymbolFontFamily">Segoe Fluent Icons</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Battuta.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Battuta.PrimaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Battuta.Title2Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Battuta.FontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Battuta.PrimaryTextBrush}" />
    </Style>
    <Style x:Key="Battuta.Title3Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Battuta.FontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Battuta.PrimaryTextBrush}" />
    </Style>
    <Style x:Key="Battuta.HeadlineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Battuta.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Battuta.PrimaryTextBrush}" />
    </Style>
    <Style x:Key="Battuta.SubheadlineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Battuta.FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Battuta.PrimaryTextBrush}" />
    </Style>
    <Style x:Key="Battuta.CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Battuta.FontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Battuta.SecondaryTextBrush}" />
    </Style>
    <Style x:Key="Battuta.Caption2Text" TargetType="TextBlock" BasedOn="{StaticResource Battuta.CaptionText}">
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="Battuta.InstrumentTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Battuta.FontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Battuta.PrimaryTextBrush}" />
    </Style>
</ResourceDictionary>
