<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Explicit Battuta brand tokens from BattutaVisualStyle.swift. -->
    <Color x:Key="Battuta.AccentColor">#B8E84D</Color>
    <Color x:Key="Battuta.AccentStrongColor">#91C92B</Color>
    <Color x:Key="Battuta.ActionAccentColor">#4A7A0A</Color>
    <Color x:Key="Battuta.CyanColor">#40B8D1</Color>
    <Color x:Key="Battuta.VioletColor">#9980EB</Color>
    <Color x:Key="Battuta.AmberColor">#F2AB33</Color>
    <Color x:Key="Battuta.OrangeColor">#F5A23A</Color>
    <Color x:Key="Battuta.RedColor">#F0645C</Color>

    <!-- Dark semantic approximations of macOS window/control/under-page colors. -->
    <Color x:Key="Battuta.CanvasColor">#F21A211A</Color>
    <Color x:Key="Battuta.CanvasOpaqueColor">#1A211A</Color>
    <Color x:Key="Battuta.SurfaceColor">#F2252925</Color>
    <Color x:Key="Battuta.RecessedColor">#D9181C18</Color>
    <Color x:Key="Battuta.InstrumentSurfaceColor">#FA060807</Color>
    <Color x:Key="Battuta.PrimaryTextColor">#F0FFFFFF</Color>
    <Color x:Key="Battuta.SecondaryTextColor">#94FFFFFF</Color>
    <Color x:Key="Battuta.TertiaryTextColor">#70FFFFFF</Color>
    <Color x:Key="Battuta.SeparatorColor">#31FFFFFF</Color>
    <Color x:Key="Battuta.InstrumentSeparatorColor">#1FFFFFFF</Color>

    <SolidColorBrush x:Key="Battuta.AccentBrush" Color="{StaticResource Battuta.AccentColor}" />
    <SolidColorBrush x:Key="Battuta.AccentStrongBrush" Color="{StaticResource Battuta.AccentStrongColor}" />
    <SolidColorBrush x:Key="Battuta.ActionAccentBrush" Color="{StaticResource Battuta.ActionAccentColor}" />
    <SolidColorBrush x:Key="Battuta.AccentSoftBrush" Color="#21B8E84D" />
    <SolidColorBrush x:Key="Battuta.CyanBrush" Color="{StaticResource Battuta.CyanColor}" />
    <SolidColorBrush x:Key="Battuta.VioletBrush" Color="{StaticResource Battuta.VioletColor}" />
    <SolidColorBrush x:Key="Battuta.AmberBrush" Color="{StaticResource Battuta.AmberColor}" />
    <SolidColorBrush x:Key="Battuta.OrangeBrush" Color="{StaticResource Battuta.OrangeColor}" />
    <SolidColorBrush x:Key="Battuta.RedBrush" Color="{StaticResource Battuta.RedColor}" />
    <SolidColorBrush x:Key="Battuta.CanvasBrush" Color="{StaticResource Battuta.CanvasColor}" />
    <SolidColorBrush x:Key="Battuta.CanvasOpaqueBrush" Color="{StaticResource Battuta.CanvasOpaqueColor}" />
    <SolidColorBrush x:Key="Battuta.SurfaceBrush" Color="{StaticResource Battuta.SurfaceColor}" />
    <SolidColorBrush x:Key="Battuta.RecessedBrush" Color="{StaticResource Battuta.RecessedColor}" />
    <SolidColorBrush x:Key="Battuta.InstrumentSurfaceBrush" Color="{StaticResource Battuta.InstrumentSurfaceColor}" />
    <SolidColorBrush x:Key="Battuta.PrimaryTextBrush" Color="{StaticResource Battuta.PrimaryTextColor}" />
    <SolidColorBrush x:Key="Battuta.SecondaryTextBrush" Color="{StaticResource Battuta.SecondaryTextColor}" />
    <SolidColorBrush x:Key="Battuta.TertiaryTextBrush" Color="{StaticResource Battuta.TertiaryTextColor}" />
    <SolidColorBrush x:Key="Battuta.SeparatorBrush" Color="{StaticResource Battuta.SeparatorColor}" />
    <SolidColorBrush x:Key="Battuta.InstrumentSeparatorBrush" Color="{StaticResource Battuta.InstrumentSeparatorColor}" />
    <SolidColorBrush x:Key="Battuta.TransparentBrush" Color="Transparent" />
</ResourceDictionary>
