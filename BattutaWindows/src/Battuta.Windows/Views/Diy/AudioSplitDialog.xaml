<Window x:Class="Battuta.Windows.Views.Diy.AudioSplitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Battuta.Windows.Controls"
        xmlns:local="clr-namespace:Battuta.Windows.Views.Diy"
        Title="拆分完整击键"
        Width="760" Height="630"
        MinWidth="760" MinHeight="630"
        MaxWidth="760" MaxHeight="630"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{DynamicResource Battuta.CanvasBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Battuta;component/Themes/BattutaTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource Battuta.CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:IconTile Width="40"
                                   Height="40"
                                   GlyphSize="17"
                                   Glyph="&#xE8C6;"
                                   AutomationProperties.Name="拆分完整击键" />
                <StackPanel Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="拆分完整击键"
                               Style="{DynamicResource Battuta.Title2Text}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Battuta.SecondaryTextBrush}"
                               Text="调整下方切点，使左侧只保留按下、右侧从回弹瞬态开始。" />
                </StackPanel>
                <controls:StatusPill x:Name="ConfidencePill"
                                     Grid.Column="2"
                                     Text="置信度 0%"
                                     Glyph="&#xE7BA;"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="自动拆分置信度" />
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource Battuta.SeparatorBrush}"
                    Opacity="0.65" />

            <Grid Grid.Row="2" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:AudioSplitWaveform x:Name="Waveform"
                                          AutomationProperties.Name="击键音频波形" />

                <Grid x:Name="PreviewRow" Grid.Row="2">
                    <StackPanel x:Name="PreviewButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button Style="{DynamicResource Battuta.SecondaryButton}"
                                Click="PreviewPressClick"
                                AutomationProperties.Name="试听按下">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           FontSize="11"
                                           Text="&#xE768;"
                                           TextTrimming="None" />
                                <TextBlock Margin="6,0,0,0" Text="试听按下" />
                            </StackPanel>
                        </Button>
                        <Button Margin="10,0,0,0"
                                Style="{DynamicResource Battuta.SecondaryButton}"
                                Click="PreviewReleaseClick"
                                AutomationProperties.Name="试听回弹">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           FontSize="11"
                                           Text="&#xE768;"
                                           TextTrimming="None" />
                                <TextBlock Margin="6,0,0,0" Text="试听回弹" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="BusyIndicator"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                AutomationProperties.LiveSetting="Polite">
                        <ProgressBar Width="24"
                                     Height="4"
                                     IsIndeterminate="True"
                                     IsHitTestVisible="False" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Battuta.CaptionText}"
                                   Text="正在生成试听…" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4"
                        Padding="12"
                        Style="{DynamicResource Battuta.CompactCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="11"
                                       Foreground="{DynamicResource Battuta.PrimaryTextBrush}"
                                       Text="&#xE8C6;"
                                       TextTrimming="None" />
                            <TextBlock Grid.Column="1"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       Text="按下 / 回弹切点" />
                            <TextBlock x:Name="SplitTimeLabel"
                                       Grid.Column="2"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{DynamicResource Battuta.SecondaryTextBrush}"
                                       Text="12 ms" />
                        </Grid>
                        <Slider x:Name="SplitSlider"
                                Margin="0,5,0,0"
                                Minimum="12"
                                Maximum="12"
                                TickFrequency="1"
                                SmallChange="1"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SplitSliderValueChanged"
                                AutomationProperties.Name="按下与回弹切点" />
                        <TextBlock x:Name="SuggestionLabel"
                                   Style="{DynamicResource Battuta.CaptionText}"
                                   Text="建议：12 ms · 回弹瞬态约在 25 ms" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="6"
                        Padding="12"
                        Style="{DynamicResource Battuta.CompactCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="11"
                                       Foreground="{DynamicResource Battuta.PrimaryTextBrush}"
                                       Text="&#xE71A;"
                                       TextTrimming="None" />
                            <TextBlock Grid.Column="1"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       Text="回弹结束" />
                            <TextBlock x:Name="ReleaseEndTimeLabel"
                                       Grid.Column="2"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{DynamicResource Battuta.SecondaryTextBrush}"
                                       Text="25 ms" />
                        </Grid>
                        <Slider x:Name="ReleaseEndSlider"
                                Margin="0,5,0,0"
                                Minimum="25"
                                Maximum="30"
                                TickFrequency="1"
                                SmallChange="1"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="ReleaseEndSliderValueChanged"
                                AutomationProperties.Name="回弹结束时间" />
                        <TextBlock Style="{DynamicResource Battuta.CaptionText}"
                                   Text="如果录音末尾还有下一次击键，可提前结束，避免混入下一个声音。" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="WarningsScroller"
                              Grid.Row="8"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed"
                              Focusable="False">
                    <ItemsControl x:Name="WarningsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               FontSize="11"
                                               Foreground="{DynamicResource Battuta.OrangeBrush}"
                                               Text="&#xE7BA;"
                                               TextTrimming="None" />
                                    <TextBlock Grid.Column="1"
                                               Margin="6,0,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource Battuta.OrangeBrush}"
                                               Text="{Binding}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource Battuta.SeparatorBrush}"
                    Opacity="0.65" />

            <Grid Grid.Row="4" Margin="16">
                <TextBlock x:Name="TargetLabel"
                           VerticalAlignment="Center"
                           Style="{DynamicResource Battuta.CaptionText}"
                           Text="将设置到：所有按键" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{DynamicResource Battuta.SecondaryButton}"
                            Content="取消"
                            Click="CancelClick"
                            AutomationProperties.Name="取消拆分" />
                    <Button x:Name="ConfirmButton"
                            Margin="8,0,0,0"
                            Style="{DynamicResource Battuta.PrimaryButton}"
                            Content="拆分并导入"
                            Click="ConfirmClick"
                            IsDefault="True"
                            AutomationProperties.Name="拆分并导入" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
