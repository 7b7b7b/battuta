<Window x:Class="Battuta.Windows.Views.Diy.SoundPackEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Battuta.Windows.Views.Diy"
        Title="Battuta · DIY 音色编辑器"
        Width="1240" Height="760" MinWidth="1120" MinHeight="660"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        Background="{DynamicResource Battuta.CanvasBrush}" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Battuta;component/Themes/BattutaTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource Battuta.CanvasBrush}">
        <Grid>
            <Grid x:Name="EditorContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" MinWidth="540" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <views:SoundPackSidebar Grid.Column="0" />
                <Border Grid.Column="1" Background="{DynamicResource Battuta.SeparatorBrush}" />
                <views:SoundPackKeyboardWorkspace Grid.Column="2" />
                <Border Grid.Column="3" Background="{DynamicResource Battuta.SeparatorBrush}" />
                <views:SoundPackInspector Grid.Column="4" />
            </Grid>
        </Grid>
    </Border>
</Window>
