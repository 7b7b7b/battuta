<UserControl x:Class="Battuta.Windows.Views.Stats.TypingStatsKeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Battuta.Windows.Controls"
             xmlns:keyboard="clr-namespace:Battuta.Windows.Controls.Keyboard"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="20" Padding="16" MaxWidth="1080" Style="{DynamicResource Battuta.Card}">
            <StackPanel>
                <Grid>
                    <controls:SectionHeading Title="键盘热力图" Subtitle="Windows 常用 ANSI 键盘布局 · 14.5U" Glyph="&#xE80A;" />
                    <StackPanel HorizontalAlignment="Right">
                        <Border Width="150" Style="{DynamicResource Battuta.SegmentPanel}">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="TodayScope" GroupName="KeyScope" Content="今日" IsChecked="True"
                                             Style="{DynamicResource Battuta.Segment}" Checked="ScopeChanged" />
                                <RadioButton x:Name="AllTimeScope" GroupName="KeyScope" Content="累计"
                                             Style="{DynamicResource Battuta.Segment}" Checked="ScopeChanged" />
                            </UniformGrid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <TextBlock Text="低" Style="{DynamicResource Battuta.Caption2Text}" />
                            <Border Width="81" Height="8" Margin="6,0" CornerRadius="3" BorderBrush="#18FFFFFF" BorderThickness="1"
                                    ToolTip="色阶按当前显示按键的非零计数自动调整">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#440154" Offset="0" />
                                        <GradientStop Color="#482475" Offset="0.13" />
                                        <GradientStop Color="#414487" Offset="0.25" />
                                        <GradientStop Color="#355F8D" Offset="0.38" />
                                        <GradientStop Color="#21918D" Offset="0.5" />
                                        <GradientStop Color="#22A884" Offset="0.63" />
                                        <GradientStop Color="#44BF70" Offset="0.75" />
                                        <GradientStop Color="#7AD151" Offset="0.88" />
                                        <GradientStop Color="#BDDF26" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="高" Style="{DynamicResource Battuta.Caption2Text}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,16" />
                <TextBlock x:Name="EmptyKeyText" Text="今天还没有按键记录；开始输入后键盘会逐键点亮。"
                           Margin="0,0,0,8" Style="{DynamicResource Battuta.CaptionText}" />
                <keyboard:KeyboardCanvas x:Name="KeyboardHeatmap" Mode="Statistics" IsInteractive="False" HorizontalAlignment="Stretch" />
                <Separator Margin="0,16" />

                <Expander Header="外接键盘与扩展按键" FontSize="11" FontWeight="SemiBold">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="导航、功能、数字键盘、国际键与额外修饰键"
                                   Style="{DynamicResource Battuta.CaptionText}" FontWeight="SemiBold" />
                        <ItemsControl x:Name="ExtendedKeyItems" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,4,4" Padding="9,5" CornerRadius="5"
                                            Background="#12FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
                                        <TextBlock Text="{Binding Text}" FontSize="10" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="OtherKeysHeading" Text="其他已识别键" Margin="0,8,0,0"
                                   Style="{DynamicResource Battuta.CaptionText}" FontWeight="SemiBold" Visibility="Collapsed" />
                        <ItemsControl x:Name="OtherKeyItems" Margin="0,6,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,4,4" Padding="9,5" CornerRadius="5"
                                            Background="#12FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
                                        <TextBlock Text="{Binding Text}" FontSize="10" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="ⓘ" Style="{DynamicResource Battuta.Caption2Text}" Margin="0,0,8,0" />
                    <TextBlock Text="按下计数包含 Shift、Win、Ctrl、Alt、回车、退格和方向键；长按产生的系统自动重复不增加物理按下次数。"
                               Style="{DynamicResource Battuta.Caption2Text}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
