<UserControl x:Class="Battuta.Windows.Controls.SectionHeading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Glyph, ElementName=Root}"
                   FontFamily="Segoe Fluent Icons"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{Binding GlyphBrush, ElementName=Root}"
                   Width="22" Height="22"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   TextAlignment="Center"
                   TextTrimming="None" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Battuta.PrimaryTextBrush}" />
            <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                       Margin="0,2,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource Battuta.SecondaryTextBrush}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Subtitle, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
